#!/usr/bin/env bash
#
# hermes — one entry point for developing, checking, running and deploying
#          tgagent. Named for the messenger: it carries things, it does not
#          decide anything.
#
#   ./hermes install         from a clean checkout to a signed-in agent
#   ./hermes                 what you can do
#   ./hermes listen          take instructions from your Telegram chats
#   ./hermes check           everything CI checks, in CI's order
#
# Design rules, so this file stays trustworthy:
#
#  * Every command is idempotent. Running it twice is never worse than once.
#  * Nothing is installed globally. All Python work happens in ./.venv.
#  * Anything that touches a real account (login, listen, serve, deploy) says
#    what it is about to do first. Anything destructive asks.
#  * The checks run in the same order as .github/workflows/ci.yml, so a green
#    `./hermes check` means a green pipeline — no second-guessing required.

set -euo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly VENV="$ROOT/.venv"
readonly PY="$VENV/bin/python"
readonly ENV_FILE="$ROOT/.env"
readonly SERVICE_NAME="tgagent"
# $USER is not exported by every shell (cron, some SSH setups); ask the system.
readonly LINGER_USER="${USER:-$(id -un)}"

# Minimum interpreter the project supports (pyproject: requires-python >=3.11).
readonly MIN_PY_MINOR=11

cd "$ROOT"

# ------------------------------------------------------------------ output ----
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  readonly C_RESET=$'\033[0m' C_DIM=$'\033[2m' C_BOLD=$'\033[1m'
  readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_CYAN=$'\033[36m'
else
  readonly C_RESET='' C_DIM='' C_BOLD='' C_RED='' C_GREEN='' C_YELLOW='' C_CYAN=''
fi

step() { printf '%s▸ %s%s\n' "$C_CYAN" "$*" "$C_RESET"; }
ok() { printf '%s✓ %s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
warn() { printf '%s! %s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
die() {
  printf '%s✗ %s%s\n' "$C_RED" "$*" "$C_RESET" >&2
  exit 1
}
hint() { printf '%s  %s%s\n' "$C_DIM" "$*" "$C_RESET"; }

confirm() {
  # Default no: a mistyped destructive command must not proceed on Enter.
  local reply
  printf '%s%s [y/N] %s' "$C_YELLOW" "$1" "$C_RESET"
  read -r reply || return 1
  [[ "$reply" =~ ^[Yy]$ ]]
}

confirm_default_yes() {
  local reply
  printf '%s%s [Y/n] %s' "$C_YELLOW" "$1" "$C_RESET"
  read -r reply || return 1
  [[ -z "$reply" || "$reply" =~ ^[Yy]$ ]]
}

interactive() { [[ -t 0 ]]; }

# ------------------------------------------------------------------ prompts ----
# ask <variable> <question> [default]        — visible answer
# ask_secret <variable> <question>           — answer is not echoed
#
# Both leave the variable untouched and return 1 on EOF, so a piped or
# non-interactive run degrades to "skip this" rather than looping on empty input.
ask() {
  local __var="$1" question="$2" default="${3:-}" reply
  if [[ -n "$default" ]]; then
    printf '%s  %s [%s]: %s' "$C_CYAN" "$question" "$default" "$C_RESET"
  else
    printf '%s  %s: %s' "$C_CYAN" "$question" "$C_RESET"
  fi
  read -r reply || return 1
  printf -v "$__var" '%s' "${reply:-$default}"
}

ask_secret() {
  local __var="$1" question="$2" reply
  printf '%s  %s (not echoed): %s' "$C_CYAN" "$question" "$C_RESET"
  read -rs reply || return 1
  printf '\n'
  printf -v "$__var" '%s' "$reply"
}

# Read one value out of .env, ignoring commented lines.
env_get() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line
  line="$(grep -m1 -E "^[[:space:]]*$1=" "$ENV_FILE" 2>/dev/null)" || return 1
  printf '%s' "${line#*=}"
}

# Set one value in .env, in place.
#
# Done in Python rather than with `sed` on purpose: an api_hash or API key is
# arbitrary text, and building a sed expression around arbitrary text is how you
# end up with a mangled credential and a confusing authentication error. This also
# uncomments a commented-out key rather than appending a duplicate below it.
env_set() {
  local key="$1" value="$2"
  KEY="$key" VALUE="$value" ENV_PATH="$ENV_FILE" "$PY" - <<'PYTHON'
import os
import re
from pathlib import Path

key, value, path = os.environ["KEY"], os.environ["VALUE"], Path(os.environ["ENV_PATH"])
lines = path.read_text(encoding="utf-8").splitlines(keepends=True) if path.exists() else []
pattern = re.compile(rf"^(\s*#\s*)?{re.escape(key)}=")

for index, line in enumerate(lines):
    if pattern.match(line):
        lines[index] = f"{key}={value}\n"
        break
else:
    if lines and not lines[-1].endswith("\n"):
        lines.append("\n")
    lines.append(f"{key}={value}\n")

path.write_text("".join(lines), encoding="utf-8")
PYTHON
}

# ------------------------------------------------------------ prerequisites ----
find_python() {
  # Newest supported interpreter wins, so a machine with several gets the best
  # one rather than whichever `python3` happens to point at.
  local candidate
  for candidate in python3.13 python3.12 python3.11 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
      "$candidate" -c "import sys; sys.exit(0 if sys.version_info >= (3, $MIN_PY_MINOR) else 1)" 2>/dev/null; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

require_venv() {
  [[ -x "$PY" ]] || die "No environment yet. Run: ./hermes setup"
}

require_env_file() {
  [[ -f "$ENV_FILE" ]] || die "No .env yet. Run: ./hermes setup"
}

# `tgagent` is installed into the venv as a console script by `pip install -e`.
tg() {
  require_venv
  "$VENV/bin/tgagent" "$@"
}

# --------------------------------------------------------------- commands -----
# The environment only. Deliberately says nothing about what to do next, because
# `install` calls this and then does the next thing itself — advice to go and fill
# in .env, printed immediately before being asked for the same values, reads as a
# script that does not know what it is doing.
_setup_environment() {
  local python
  python="$(find_python)" || die "Python 3.$MIN_PY_MINOR or newer is required but was not found."
  step "Using $($python --version)"

  if [[ ! -x "$PY" ]]; then
    step "Creating $VENV"
    "$python" -m venv "$VENV"
  fi

  step "Installing tgagent with development extras"
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -e ".[dev]"
  ok "Dependencies installed"

  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ROOT/.env.example" "$ENV_FILE"
    # The file is about to hold an api_hash and a model API key.
    chmod 600 "$ENV_FILE"
    ok "Created .env from .env.example"
  else
    ok ".env already present, left untouched"
  fi
}

cmd_setup() {
  _setup_environment
  printf '\n'
  ok "Ready."
  if [[ -z "$(env_get TGAGENT_TELEGRAM__API_HASH || true)" ]]; then
    warn "TGAGENT_TELEGRAM__API_ID, __API_HASH and TGAGENT_LLM__API_KEY are still blank."
    hint "api_id / api_hash: https://my.telegram.org/apps"
    hint "or let the installer ask you for them: ./hermes install"
  else
    hint "next: ./hermes doctor   then ./hermes login   then ./hermes listen"
  fi
}

cmd_install() {
  printf '%stgagent installer%s\n' "$C_BOLD" "$C_RESET"
  printf '%sThree steps: dependencies, credentials, sign-in. Ctrl-C is safe at any point.%s\n\n' \
    "$C_DIM" "$C_RESET"

  _setup_environment
  printf '\n'

  if ! interactive; then
    warn "Not attached to a terminal, so credentials were not collected."
    hint "Set them in .env, then: ./hermes login && ./hermes listen"
    return 0
  fi

  _install_configure_telegram
  _install_configure_llm
  chmod 600 "$ENV_FILE"

  printf '\n'
  step "Checking the result"
  if tg config check; then
    ok "Configuration is complete."
  else
    warn "Something is still missing above. Edit .env and re-run ./hermes install."
    return 1
  fi

  printf '\n'
  if confirm_default_yes "Sign in to Telegram now?"; then
    printf '\n'
    cmd_login || {
      warn "Sign-in did not complete. Run ./hermes login when you are ready."
      return 1
    }
  else
    hint "Sign in later with: ./hermes login"
    return 0
  fi

  printf '\n'
  ok "Installed."
  printf '\n'
  printf 'Start it in this terminal:      %s./hermes listen%s\n' "$C_BOLD" "$C_RESET"
  printf 'Or install it as a service:     %s./hermes deploy%s\n' "$C_BOLD" "$C_RESET"
  printf '\nThen, in any Telegram chat:     %s%s what did I miss today?%s\n' \
    "$C_BOLD" "$(env_get TGAGENT_CONTROL__TRIGGER || printf 'agent')" "$C_RESET"
}

_install_configure_telegram() {
  step "Telegram credentials"
  hint "From https://my.telegram.org/apps — sign in with the account the agent will use,"
  hint "then 'API development tools'. These identify the app, not the account."
  printf '\n'

  local existing api_id api_hash phone attempt
  existing="$(env_get TGAGENT_TELEGRAM__API_ID || true)"
  if [[ -n "$existing" && "$existing" != "0" ]]; then
    ok "api_id already set to $existing"
    if ! confirm "Replace the stored Telegram credentials?"; then
      return 0
    fi
  fi

  for attempt in 1 2 3; do
    ask api_id "api_id (digits only)" || return 0
    [[ "$api_id" =~ ^[0-9]+$ ]] && break
    warn "api_id is a number, e.g. 1234567. ($attempt of 3)"
    api_id=""
  done
  [[ -n "${api_id:-}" ]] || {
    warn "Skipping Telegram credentials."
    return 0
  }

  for attempt in 1 2 3; do
    ask_secret api_hash "api_hash" || return 0
    [[ "$api_hash" =~ ^[0-9a-fA-F]{32}$ ]] && break
    warn "api_hash is 32 hexadecimal characters. ($attempt of 3)"
    api_hash=""
  done
  [[ -n "${api_hash:-}" ]] || {
    warn "Skipping Telegram credentials."
    return 0
  }

  env_set TGAGENT_TELEGRAM__API_ID "$api_id"
  env_set TGAGENT_TELEGRAM__API_HASH "$api_hash"

  # Optional: `tgagent login` prompts for it if it is absent.
  ask phone "phone number in E.164 form, e.g. +15551234567 (optional)" || true
  if [[ -n "${phone:-}" && "$phone" =~ ^\+[0-9]{7,15}$ ]]; then
    env_set TGAGENT_TELEGRAM__PHONE "$phone"
  elif [[ -n "${phone:-}" ]]; then
    warn "That is not E.164 format; leaving it unset. login will ask you."
  fi
  ok "Telegram credentials stored in .env (mode 600)"
}

_install_configure_llm() {
  printf '\n'
  step "Model provider"

  local existing_key choice provider model key base_url
  existing_key="$(env_get TGAGENT_LLM__API_KEY || true)"
  if [[ -n "$existing_key" ]]; then
    ok "A model API key is already set"
    if ! confirm "Replace the stored model provider settings?"; then
      return 0
    fi
  fi

  printf '    1) Anthropic        claude-opus-5\n'
  printf '    2) OpenAI           gpt-5\n'
  printf '    3) OpenRouter       any hosted model\n'
  printf '    4) Local / other    any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio)\n'
  ask choice "Which one" "1" || return 0

  case "$choice" in
  1) provider=anthropic model=claude-opus-5 ;;
  2) provider=openai model=gpt-5 ;;
  3) provider=openrouter model=anthropic/claude-opus-5 ;;
  4) provider=openai-compatible model="" ;;
  *)
    warn "Unrecognised choice; leaving the provider as it is."
    return 0
    ;;
  esac

  ask model "model id" "$model" || return 0
  env_set TGAGENT_LLM__PROVIDER "$provider"
  [[ -n "${model:-}" ]] && env_set TGAGENT_LLM__MODEL "$model"

  if [[ "$provider" == "openai-compatible" ]]; then
    ask base_url "base URL" "http://localhost:11434/v1" || return 0
    env_set TGAGENT_LLM__BASE_URL "$base_url"
    hint "A local endpoint usually needs no key — leave it blank if so."
  fi

  ask_secret key "API key" || return 0
  if [[ -n "${key:-}" ]]; then
    env_set TGAGENT_LLM__API_KEY "$key"
    ok "Provider set to $provider"
  else
    hint "No key stored. The provider's own environment variable will be used if set."
  fi
}

cmd_check() {
  require_venv
  # Same order as CI: formatting and lint first because they are the fastest
  # way to a red pipeline, then types, then the suite.
  step "ruff format --check"
  "$VENV/bin/ruff" format --check .
  step "ruff check"
  "$VENV/bin/ruff" check .
  step "mypy"
  "$VENV/bin/mypy"
  step "pytest"
  "$PY" -m pytest -q -p no:randomly "$@"
  step "bandit"
  "$VENV/bin/bandit" -r src/tgagent -c pyproject.toml -q
  step "pip-audit"
  cmd_audit_deps
  printf '\n'
  ok "Everything CI checks passes locally."
}

# Kept identical to the CI step, including the reason for the indirection: the
# environment holds tgagent itself, installed editable and unpublished, which
# --strict cannot audit and --skip-editable does not excuse.
cmd_audit_deps() {
  require_venv
  # Cleaned up explicitly rather than with `trap … RETURN`: that trap runs after
  # the function's `local` has gone out of scope, so under `set -u` it dies on an
  # unbound variable *after* a successful audit — turning a pass into a failure.
  local frozen status=0
  frozen="$(mktemp)"
  "$PY" -m pip freeze --exclude-editable >"$frozen"
  hint "auditing $(grep -c '' "$frozen") dependencies"
  "$VENV/bin/pip-audit" --strict --desc --no-deps -r "$frozen" || status=$?
  rm -f "$frozen"
  return "$status"
}

cmd_fix() {
  require_venv
  step "ruff format"
  "$VENV/bin/ruff" format .
  step "ruff check --fix"
  "$VENV/bin/ruff" check --fix .
  ok "Formatted and auto-fixed. Re-run ./hermes check."
}

cmd_test() {
  require_venv
  "$PY" -m pytest "$@"
}

cmd_doctor() {
  require_venv
  step "Version"
  tg version
  printf '\n'
  step "Configuration"
  # `config check` exits non-zero when Telegram credentials are missing, which
  # is the whole point of running it — report it without aborting the rest.
  tg config check || warn "Configuration is incomplete (see above)."
  printf '\n'
  step "Sandbox isolation"
  tg sandbox
  printf '\n'
  step "Permission policy"
  tg config policy
}

# Which model ids the configured endpoint will actually accept.
#
# A wrong TGAGENT_LLM__MODEL is the single most common reason a run dies before it
# starts, and it is needlessly hard to diagnose: gateways answer with 404 and
# frequently cannot even echo back the name they failed to resolve, so the error
# reads "Model 'N/A' not found". This asks the endpoint directly.
cmd_models() {
  require_venv
  require_env_file
  step "Asking the configured endpoint what it serves"
  "$PY" - <<'PYTHON'
import asyncio

from tgagent.config.settings import load_settings

settings = load_settings().llm
print(f"  provider : {settings.provider}")
print(f"  base_url : {settings.base_url or '(provider default)'}")
print(f"  model    : {settings.model}   <- TGAGENT_LLM__MODEL")
print()


async def main() -> int:
    try:
        import openai
    except ImportError:
        print('  The openai SDK is not installed: pip install "tgagent[openai]"')
        return 1

    kwargs = {"timeout": 30.0, "max_retries": 0}
    if settings.api_key is not None:
        kwargs["api_key"] = settings.api_key.get_secret_value()
    elif settings.base_url:
        kwargs["api_key"] = "not-required"
    if settings.base_url:
        kwargs["base_url"] = settings.base_url

    client = openai.AsyncOpenAI(**kwargs)
    try:
        listing = await client.models.list()
        ids = sorted(m.id for m in listing.data)
    except Exception as exc:
        print(f"  Could not list models: {exc}")
        print("  Not every gateway implements /models; check its documentation.")
        return 1
    finally:
        await client.close()

    if not ids:
        print("  The endpoint returned an empty catalogue.")
        return 1

    print(f"  {len(ids)} model(s) available:")
    for identifier in ids:
        mark = "  <- currently configured" if identifier == settings.model else ""
        print(f"    {identifier}{mark}")
    if settings.model not in ids:
        print()
        print(f"  {settings.model!r} is NOT in that list — that is why runs fail with 404.")
        print("  Set TGAGENT_LLM__MODEL in .env to one of the ids above.")
    return 0


raise SystemExit(asyncio.run(main()))
PYTHON
}

cmd_login() {
  require_venv
  require_env_file
  step "Signing in to Telegram"
  hint "Telegram will send a code to the account's other sessions."
  hint "The session file it writes is a live credential — it is git-ignored; keep it that way."
  tg login "$@"
}

cmd_listen() {
  require_venv
  require_env_file
  step "Listening for commands in your Telegram chats"
  hint "In any chat, type: agent <instruction>"
  hint "agent stop · agent reset · agent help"
  hint "Only your own messages count as commands unless control.allowed_senders says otherwise."
  tg listen "$@"
}

cmd_run() {
  require_venv
  require_env_file
  [[ $# -gt 0 ]] || die 'Give it something to do, e.g.: ./hermes run "what did I miss today?"'
  tg run "$@"
}

cmd_chat() {
  require_venv
  require_env_file
  tg chat "$@"
}

cmd_serve() {
  require_venv
  require_env_file
  step "Running the scheduler in the foreground"
  hint "Scheduled runs are unattended: anything needing confirmation is denied by default."
  tg serve "$@"
}

cmd_tasks() {
  require_venv
  tg tasks "$@"
}

cmd_audit() {
  require_venv
  tg audit "$@"
}

# ----------------------------------------------------------------- docker -----
compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    die "Neither 'docker compose' nor 'docker-compose' is available."
  fi
}

cmd_docker() {
  local action="${1:-up}"
  shift || true
  require_env_file

  case "$action" in
  build) compose build "$@" ;;
  up)
    step "Starting the container detached"
    compose up -d --build "$@"
    compose ps
    hint "logs: ./hermes docker logs"
    ;;
  down) compose down "$@" ;;
  logs) compose logs -f --tail=100 "$@" ;;
  ps) compose ps "$@" ;;
  login)
    # Signing in needs a code typed at a terminal, so it cannot happen in a
    # detached container — this is the documented one-time interactive step.
    step "Interactive login inside a throwaway container"
    compose run --rm tgagent login
    ;;
  *) die "Unknown docker action '$action'. Try: build up down logs ps login" ;;
  esac
}

# ---------------------------------------------------------------- systemd -----
# A user service, not a system one: the agent holds a personal Telegram session,
# so it belongs to a user account and not to root.
readonly UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
readonly UNIT_PATH="$UNIT_DIR/$SERVICE_NAME.service"

require_systemd() {
  command -v systemctl >/dev/null 2>&1 || die "systemd is not available on this machine."
}

write_unit() {
  mkdir -p "$UNIT_DIR"
  cat >"$UNIT_PATH" <<UNIT
[Unit]
Description=tgagent — Telegram agent (control bridge + scheduler)
Documentation=file://$ROOT/docs/telegram-control.md
After=network-online.target
Wants=network-online.target
# These belong to [Unit], not [Service] — systemd ignores them there and says so
# in the journal ("Unknown key 'StartLimitIntervalSec' in section [Service]"),
# which quietly leaves a restart loop unbounded.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$VENV/bin/tgagent listen --scheduler
# The session file and database are credentials; keep the log free of chat text.
Environment=TGAGENT_LOGGING__FORMAT=json
# always, not on-failure: a listener that can no longer hear anything exits 1 on
# purpose, and even a clean exit should be replaced rather than left stopped.
Restart=always
# Telegram rate-limits an account that reconnects in a tight loop, so the burst
# limit above is what stops a crash loop from costing the account.
RestartSec=10

# The process needs its data directory and nothing else on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.local/share/tgagent
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=1G

[Install]
WantedBy=default.target
UNIT
}

cmd_deploy() {
  require_venv
  require_env_file
  require_systemd

  # Deploying a listener that cannot sign in would just crash-loop against
  # Telegram, which is exactly the thing StartLimitBurst is there to survive —
  # better to refuse up front.
  if ! tg config check >/dev/null 2>&1; then
    tg config check || true
    die "Configuration is incomplete. Fix .env, then run ./hermes deploy again."
  fi

  # Lingering first, and it is not optional. Without it systemd stops the whole
  # user manager when your last session ends, taking every --user service with
  # it: the journal shows an orderly "Stopping tgagent.service", the user
  # manager comes back with a new PID next login, and the same build under
  # `nohup` runs for weeks because those processes live in the session scope
  # instead. Warning about it was not enough — a warning in a wall of deploy
  # output is a warning nobody reads.
  ensure_linger

  step "Installing the user service at $UNIT_PATH"
  write_unit
  systemctl --user daemon-reload
  systemctl --user enable "$SERVICE_NAME.service"
  systemctl --user restart "$SERVICE_NAME.service"

  printf '\n'
  ok "Deployed. It will start again on boot and restart on failure."
  hint "status: ./hermes status   ·   logs: ./hermes logs   ·   stop: ./hermes undeploy"
  printf '\n'
  systemctl --user --no-pager --lines=0 status "$SERVICE_NAME.service" || true
}

linger_on() {
  loginctl show-user "$LINGER_USER" --property=Linger 2>/dev/null | grep -q 'Linger=yes'
}

ensure_linger() {
  if linger_on; then
    ok "Lingering is on: the service survives logout."
    return 0
  fi

  step "Enabling lingering for $LINGER_USER"
  loginctl enable-linger "$LINGER_USER" 2>/dev/null ||
    sudo loginctl enable-linger "$LINGER_USER" 2>/dev/null || true

  if linger_on; then
    ok "Lingering enabled."
    return 0
  fi

  # Refusing beats deploying something that provably dies at logout.
  warn "Could not enable lingering for $LINGER_USER."
  printf '
'
  printf '  Without it, systemd stops this service the moment your session ends,
'
  printf '  which looks exactly like the agent crashing for no reason.

'
  printf '  Run this, then deploy again:

'
  printf '      %ssudo loginctl enable-linger %s%s

' "$C_BOLD" "$LINGER_USER" "$C_RESET"
  die "Refusing to install a service that will not outlive this login."
}

cmd_undeploy() {
  require_systemd
  confirm "Stop and remove the $SERVICE_NAME user service?" || {
    warn "Left alone."
    return 0
  }
  systemctl --user disable --now "$SERVICE_NAME.service" 2>/dev/null || true
  rm -f "$UNIT_PATH"
  systemctl --user daemon-reload
  ok "Service removed. Your session file and database were not touched."
}

cmd_status() {
  require_systemd
  if linger_on; then
    ok "Lingering: on (survives logout)"
  else
    warn "Lingering: OFF — this service dies when your session ends."
    hint "sudo loginctl enable-linger $LINGER_USER"
  fi
  systemctl --user --no-pager status "$SERVICE_NAME.service" || true
}

cmd_logs() {
  require_systemd
  journalctl --user -u "$SERVICE_NAME.service" -f -n "${1:-100}"
}

cmd_restart() {
  require_systemd
  systemctl --user restart "$SERVICE_NAME.service"
  ok "Restarted."
}

# ------------------------------------------------------------------- help -----
cmd_help() {
  cat <<HELP
${C_BOLD}hermes${C_RESET} — carry tgagent from a clean checkout to a running deployment.

${C_BOLD}Getting started${C_RESET}
  ${C_BOLD}install${C_RESET}            Everything at once: dependencies, credentials, sign-in
  setup              Just the environment: ./.venv, dependencies, a seeded .env
  doctor             Report what is configured, what is not, and what the sandbox isolates
  models             List the model ids your configured endpoint actually accepts
  login              Sign in to Telegram (interactive, needed once)

${C_BOLD}Using it${C_RESET}
  listen             Take instructions from your Telegram chats: type '${C_BOLD}agent <instruction>${C_RESET}' in any chat
  run "<prompt>"     One request from the terminal, then exit
  chat               Interactive terminal session
  serve              Run scheduled tasks in the foreground
  tasks ...          Manage scheduled tasks (list | add | remove | run)
  audit              Show recent security-relevant operations

${C_BOLD}Developing${C_RESET}
  check [pytest…]    Everything CI checks: format, lint, types, tests, bandit, pip-audit
  audit-deps         Just the dependency vulnerability scan
  fix                Apply formatting and auto-fixable lint
  test [pytest…]     Run the suite with your own arguments

${C_BOLD}Deploying${C_RESET}
  deploy             Install + start a systemd --user service (listen + scheduler)
  status | logs      Inspect the deployed service
  restart | undeploy Restart it, or remove it
  docker <action>    build | up | down | logs | ps | login

${C_DIM}Once deployed, you never need this terminal again: talk to it from Telegram.${C_RESET}
HELP
}

# ------------------------------------------------------------------- main -----
main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
  install) cmd_install "$@" ;;
  setup) cmd_setup "$@" ;;
  check) cmd_check "$@" ;;
  audit-deps) cmd_audit_deps "$@" ;;
  fix) cmd_fix "$@" ;;
  test) cmd_test "$@" ;;
  doctor) cmd_doctor "$@" ;;
  models) cmd_models "$@" ;;
  login) cmd_login "$@" ;;
  listen) cmd_listen "$@" ;;
  run) cmd_run "$@" ;;
  chat) cmd_chat "$@" ;;
  serve) cmd_serve "$@" ;;
  tasks) cmd_tasks "$@" ;;
  audit) cmd_audit "$@" ;;
  docker) cmd_docker "$@" ;;
  deploy) cmd_deploy "$@" ;;
  undeploy) cmd_undeploy "$@" ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  help | -h | --help) cmd_help ;;
  *)
    printf '%sUnknown command: %s%s\n\n' "$C_RED" "$command" "$C_RESET" >&2
    cmd_help
    exit 2
    ;;
  esac
}

main "$@"
