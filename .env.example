# tgagent configuration.
#
#   cp .env.example .env      then fill in the values below.
#
# .env is git-ignored. Everything here can also be set as a real environment
# variable — the file is only a convenience. Nested settings use a double
# underscore: TGAGENT_<SECTION>__<FIELD>.

# ─────────────────────────────────────────────────────────────────────────────
# Telegram  (required)
#
# Get api_id and api_hash from https://my.telegram.org/apps — sign in with the
# phone number of the account the agent will operate, then "API development
# tools". These identify the *application*, not the account, but they are still
# secrets: anyone with them can impersonate this client.
# ─────────────────────────────────────────────────────────────────────────────
TGAGENT_TELEGRAM__API_ID=
TGAGENT_TELEGRAM__API_HASH=

# E.164 format. Only needed for `tgagent login`; you will be prompted otherwise.
TGAGENT_TELEGRAM__PHONE=+15551234567

# Shown in Telegram's "active sessions" list. Be honest — you want to recognise
# this client when auditing your own account.
# TGAGENT_TELEGRAM__DEVICE_MODEL=tgagent

# Optional proxy. Needs the extra: pip install "tgagent[proxy]"
# TGAGENT_TELEGRAM__PROXY=socks5://user:pass@127.0.0.1:1080

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider  (required)
#
# `provider` names an adapter; nothing else in the system is vendor-specific.
# Built in: anthropic | openai | openai-compatible | openrouter | ollama | fake
# ─────────────────────────────────────────────────────────────────────────────
TGAGENT_LLM__PROVIDER=anthropic
TGAGENT_LLM__MODEL=claude-opus-5
TGAGENT_LLM__API_KEY=

# For any OpenAI-compatible endpoint (OpenRouter, Groq, vLLM, Ollama, LM Studio):
#   TGAGENT_LLM__PROVIDER=openai-compatible
#   TGAGENT_LLM__BASE_URL=http://localhost:11434/v1
#   TGAGENT_LLM__MODEL=llama3.3:70b

# Used for compaction decisions, not sent to the provider. Set it to the real
# window of the model you chose.
# TGAGENT_LLM__CONTEXT_WINDOW=200000
# TGAGENT_LLM__MAX_OUTPUT_TOKENS=8192

# Sampling parameters are UNSET by default and are only sent when you set them —
# several current models reject them outright.
# TGAGENT_LLM__TEMPERATURE=0.7

# Reasoning-effort hint, where supported: low | medium | high | xhigh | max
# TGAGENT_LLM__EFFORT=high
# TGAGENT_LLM__THINKING=true

# ─────────────────────────────────────────────────────────────────────────────
# Permissions  (defaults are conservative; loosen deliberately)
# ─────────────────────────────────────────────────────────────────────────────
# A YAML policy file overrides the built-in defaults. See policy.example.yaml.
# TGAGENT_PERMISSIONS__POLICY_FILE=./policy.yaml

# Global kill switch: refuse every write operation.
# TGAGENT_PERMISSIONS__READ_ONLY_MODE=false

# Blast-radius cap on externally-visible operations in a single run.
# TGAGENT_PERMISSIONS__MAX_OUTBOUND_PER_RUN=20

# What a scheduled (unattended) run does when something needs confirmation.
# allow | confirm | deny  — `deny` is strongly recommended.
# TGAGENT_PERMISSIONS__NON_INTERACTIVE_DECISION=deny

# ─────────────────────────────────────────────────────────────────────────────
# Sandbox  (see docs/sandboxing.md for what each backend actually guarantees)
#
#   subprocess  portable default: separate process, no credentials, no network
#               module, import allow-list, POSIX rlimits where available
#   docker      real isolation: --network=none, read-only rootfs, cgroup limits
#   disabled    no code execution at all
#   inprocess   NO ISOLATION — tests only
# ─────────────────────────────────────────────────────────────────────────────
TGAGENT_SANDBOX__BACKEND=subprocess
# TGAGENT_SANDBOX__TIMEOUT=60
# TGAGENT_SANDBOX__MAX_MEMORY_MB=512
# TGAGENT_SANDBOX__MAX_RPC_CALLS=200
# TGAGENT_SANDBOX__DOCKER_IMAGE=python:3.12-slim

# ─────────────────────────────────────────────────────────────────────────────
# Execution budgets
# ─────────────────────────────────────────────────────────────────────────────
# TGAGENT_AGENT__MAX_STEPS=25
# TGAGENT_AGENT__MAX_TOOL_CALLS=100
# TGAGENT_AGENT__RUN_TIMEOUT=1800
# TGAGENT_AGENT__COMPACTION_THRESHOLD=0.7

# ─────────────────────────────────────────────────────────────────────────────
# Storage, media, logging, scheduling
# ─────────────────────────────────────────────────────────────────────────────
# Everything defaults under this directory.
# TGAGENT_DATA_DIR=./tgagent-data

# TGAGENT_MEDIA__MAX_FILE_BYTES=104857600
# TGAGENT_MEDIA__RETENTION_DAYS=7

# console | json   — use json when shipping logs anywhere.
TGAGENT_LOGGING__FORMAT=console
TGAGENT_LOGGING__LEVEL=INFO
# Telegram call arguments contain message text (user data). Off by default.
# TGAGENT_LOGGING__LOG_CALL_ARGUMENTS=false

# TGAGENT_SCHEDULER__ENABLED=true
# TGAGENT_SCHEDULER__DEFAULT_TIMEZONE=Europe/London

# ─────────────────────────────────────────────────────────────────────────────
# Telegram control  — driving the agent from inside Telegram
#
# With `tgagent listen` running, typing `agent <instruction>` in any chat hands
# that instruction to the agent, along with the chat it was typed in, and the
# answer comes back as a reply. See docs/telegram-control.md.
#
# Only your own outgoing messages count as commands. Everyone else's text —
# including a message you reply to — is fenced as untrusted data, not obeyed.
# ─────────────────────────────────────────────────────────────────────────────
# Run the bridge as part of `tgagent serve` too. `tgagent listen` does not need it.
# TGAGENT_CONTROL__ENABLED=false

# The word that opens a command. Matched case-insensitively, at the start of a
# message only, and it must be followed by an instruction — so ordinary prose
# that merely mentions the word is not a command.
# TGAGENT_CONTROL__TRIGGER=agent

# Anyone on this list can spend your tokens and act as your account. Empty means
# nobody but you, which is the safe default.
# TGAGENT_CONTROL__ALLOWED_SENDERS=["@my_other_account"]

# Restrict which chats accept commands. ignored_chats wins over allowed_chats.
# TGAGENT_CONTROL__ALLOWED_CHATS=["-1001234567890"]
# TGAGENT_CONTROL__IGNORED_CHATS=["@some_busy_group"]

# Acknowledge a command immediately and keep editing that one message with what
# the run is doing, until the answer replaces it. Off, the answer simply arrives
# when it is ready — which is the one thing an edit will not do: notify you.
# TGAGENT_CONTROL__PROGRESS_UPDATES=true
# TGAGENT_CONTROL__PROGRESS_INTERVAL=5.0

# Ask for confirmations in the chat (reply `yes` / `no`). With this off, a CONFIRM
# decision falls through to permissions.non_interactive_decision — deny.
# TGAGENT_CONTROL__CONFIRM_IN_CHAT=true

# chat = every chat keeps its own conversation | global = one shared thread.
# TGAGENT_CONTROL__CONVERSATION_SCOPE=chat

# Hard ceiling on accepted commands per minute, across all chats. This is a loop
# breaker, not a UX limit: leave it alone unless you know why you are changing it.
# TGAGENT_CONTROL__MAX_COMMANDS_PER_MINUTE=6

# ─────────────────────────────────────────────────────────────────────────────
# Answering people for you  (docs/autoreply.md)
#
# "Reply to him the way I would while I'm on the flight." Each message that
# person sends starts a run, and the answer is sent to that chat as you.
#
# OFF by default, and read the doc before changing that: this is the only path
# where your account speaks to somebody else without a per-message confirmation.
# The person on the other end believes they are talking to you.
# ─────────────────────────────────────────────────────────────────────────────
# TGAGENT_AUTOREPLY__ENABLED=false

# Every watch ends by itself — an expiry and a reply budget, whichever comes
# first. There is no setting that makes one permanent.
# TGAGENT_AUTOREPLY__DEFAULT_TTL_MINUTES=240
# TGAGENT_AUTOREPLY__MAX_TTL_MINUTES=10080
# TGAGENT_AUTOREPLY__MAX_REPLIES_PER_WATCH=20
# TGAGENT_AUTOREPLY__MAX_WATCHES=5

# Loop breakers. Two accounts both running this would otherwise talk to each
# other until one ran out of credit. The cooldown also collapses a burst of
# messages into a single answer.
# TGAGENT_AUTOREPLY__MAX_REPLIES_PER_HOUR=30
# TGAGENT_AUTOREPLY__COOLDOWN_SECONDS=5.0

# Prepended to every automatic reply. Empty means it reads as you, which is
# usually the point — but some jurisdictions require automated correspondence to
# be disclosed, and that is your call to make.
# TGAGENT_AUTOREPLY__PREFIX="🤖 "
# TGAGENT_AUTOREPLY__TYPING_INDICATOR=true

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────────────────────────
# TGAGENT_FEATURES__CODE_EXECUTION=true
# TGAGENT_FEATURES__MEDIA_DOWNLOAD=true
# TGAGENT_FEATURES__MEDIA_UPLOAD=false
# TGAGENT_FEATURES__SCHEDULING=true
# TGAGENT_FEATURES__MEMORY=true
# TGAGENT_FEATURES__INJECTION_SCANNER=true
